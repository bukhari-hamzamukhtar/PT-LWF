# Copy this file to .env.local for local development and fill in real values.
# In production (Vercel), set these same 3 variables under:
# Project → Settings → Environment Variables — do NOT commit real secrets here.

# Supabase project URL — Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://dihmpzmxjoyeqemsjasj.supabase.co

# Supabase service_role key — Project Settings → API → Project API keys → service_role
# Full database access. Server-side only. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the Project Topi lock screen. Defaults to "ahmadshah" in code if unset.
ADMIN_PASSWORD=ahmadshah
